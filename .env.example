OPENAI_API_KEY=<your-model-api-key>
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
KNOWLEDGE_BASE_URL=
ENABLE_SYNC_WEB_SUPPLEMENT=false
API_KEYS=
API_KEY_REGISTRY_PATH=
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=60
KNOWLEDGE_REQUEST_TIMEOUT_SECONDS=20

# Account, invite-only registration, email verification, session, and daily quota
APP_DB_PATH=data/app/application.sqlite
DOMAIN_LEXICON_RUNTIME_PATH=data/app/domain_lexicon_runtime.json
AUTH_REQUIRED=true
REGISTRATION_ENABLED=true
SESSION_COOKIE_NAME=kb_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
DAILY_QUOTA_DEFAULT=10
QUOTA_TIMEZONE=Asia/Shanghai
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_SECRET=<long-random-secret>
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_DAILY_LIMIT=5
EMAIL_DEBUG=false
EMAIL_PROVIDER=agentmail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=geowiki@agentmail.to
AGENTMAIL_BASE_URL=https://api.agentmail.to/v0
AGENTMAIL_PROXY_URL=
PUBLIC_BASE_URL=

# Aliyun Bailian / DashScope embedding.  The generic EMBEDDING_* settings are
# retained for legacy v3 maintenance jobs.  The active v4 query route uses the
# V4_* settings below and qwen3.7-text-embedding.
DASHSCOPE_API_KEY=
EMBEDDING_PROVIDER=aliyun
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# Controlled Agentic RAG v1.0
QUERY_PLANNER_ENABLED=true
UNIFIED_QUERY_PLANNING_ENABLED=true
PARALLEL_QUERY_ANALYSIS_ENABLED=false
FAST_PATH_SHADOW_ENABLED=false
FAST_PATH_SHADOW_SAMPLE_RATE=0.2
FAST_PATH_SHADOW_LOG_PATH=data/app/fast_path_shadow.jsonl
FAST_PATH_SHADOW_MAX_BYTES=2097152
FAST_PATH_SHADOW_BACKUP_COUNT=2
FAST_PATH_SHADOW_DEDUP_TTL_SECONDS=86400
FAST_PATH_SHADOW_DEDUP_MAX_ENTRIES=4096
FAST_PATH_SHADOW_MAX_CONCURRENCY=1
# Optional. If empty, EMAIL_VERIFICATION_SECRET is reused only as an HMAC key.
FAST_PATH_SHADOW_HASH_KEY=
EVIDENCE_RERANKER_ENABLED=true
QUESTION_RESOLUTION_ENABLED=true
QUESTION_RESOLUTION_MAX_TOKENS=900
QUESTION_RESOLUTION_MIN_CONFIDENCE=0.55
PROMPT_REGISTRY_ENABLED=true
PROMPT_CALIBRATION_ENABLED=false
PROMPT_CALIBRATION_VARIANT=baseline
PROMPT_CALIBRATION_INTENTS=
PROMPT_LAYOUT_VARIANT=schema_prefix
LLM_USAGE_LEDGER_ENABLED=false
LLM_USAGE_LEDGER_PATH=data/app/llm_stage_usage.jsonl
LLM_USAGE_LEDGER_MAX_BYTES=2097152
LLM_USAGE_LEDGER_BACKUP_COUNT=2
QUERY_PLANNER_MAX_TOKENS=600
EVIDENCE_RERANKER_MAX_TOKENS=800
ANSWER_MAX_TOKENS=1000
STRUCTURED_TEMPERATURE=0
ANSWER_TEMPERATURE=0.2
MAX_RETRIEVAL_ROUNDS=2
CONTROLLED_MULTI_QUERY_ENABLED=true
CONTROLLED_MULTI_QUERY_MAX=2
MMR_ENABLED=true
MMR_LAMBDA=0.7
MMR_DUPLICATE_TRIGGER=0.8
# Legacy v3-only ANN controls.  The active v4 runtime uses an exact cosine scan
# over the hash-pinned 23,250-row matrix and does not use ANN or a graph.
ANN_SEARCH_ENABLED=false
ANN_EXPANSION_SEARCH=64
VECTOR_FALLBACK_SCAN_LIMIT=100
ANN_INDEX_PATH=data/knowledge_base/indexes/dense.usearch
ANN_MANIFEST_PATH=data/knowledge_base/indexes/dense_manifest.json
# Current production-compatible private runtime.  The referenced artifacts are
# Git-ignored and must be provisioned separately; v3 remains a rollback asset.
KNOWLEDGE_RUNTIME_VERSION=v4
V4_RUNTIME_MANIFEST=data/knowledge_base_v4/runtime_private/hybrid_fixed20_v4/runtime_manifest.json
V4_CANDIDATE_DB_PATH=data/knowledge_base_v4/runtime_private/candidates.sqlite
V4_EMBEDDING_MODEL=qwen3.7-text-embedding
V4_EMBEDDING_DIMENSIONS=1024
V4_EMBEDDING_TIMEOUT_SECONDS=3
V4_EMBEDDING_MAX_RETRIES=1
V4_QUERY_EMBEDDING_CACHE_SIZE=256
RETRIEVAL_TRACE_ENABLED=true
RETRIEVAL_TRACE_PATH=data/app/retrieval_traces.jsonl
